# Optional. Leave unset for a standard LAN/localhost setup — the app derives
# the backend URL from the page's own host at runtime (see src/constants/env_variable.ts).
# Set only if the backend is on a different host or a non-derivable URL.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Optional. Backend port used when NEXT_PUBLIC_BACKEND_URL is not set. Default 3000.
# NEXT_PUBLIC_BACKEND_PORT=3000
