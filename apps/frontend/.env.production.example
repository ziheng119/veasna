# Used by "npm run build" and "npm start" (clinic network). The value is fixed into the build:
# run "npm run build" again after changing it.
#
# Recommended: leave NEXT_PUBLIC_BACKEND_URL unset. Browsers then reach the backend on the
# address they opened the app with (the host's IP or veasna.local), port 3000.
# Set it only when the backend runs on a different laptop or another port:
# NEXT_PUBLIC_BACKEND_URL=http://192.168.68.50:3000
