# Used by "npm start" on the clinic host: other devices connect over the Deco Wi-Fi. Wins over .env.
# Exact frontend origins allowed to call the API and live updates (comma-separated).
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001
# true: also allow any frontend on a private LAN address (192.168.x.x, 10.x.x.x, 172.16-31.x.x)
# or a .local name, so devices can open the app by the host's IP or veasna.local.
ALLOW_LAN_ORIGINS=true
# Name devices can use instead of the IP: veasna -> http://veasna.local:3001 (mDNS, no internet
# needed). Leave empty to turn off. Use a different name for each host on the same network.
MDNS_NAME=veasna
