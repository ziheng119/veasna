DB_USER=your_postgres_user
DB_HOST=localhost
DB_NAME=veasna_screening
DB_PASSWORD=your_postgres_password
DB_PORT=5432

PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_long_random_secret
# Exact frontend origins allowed to call the API and live updates (comma-separated).
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001
# true: also allow any frontend on a private LAN address (192.168.x.x, 10.x.x.x, 172.16-31.x.x).
# Use when several frontend devices share this backend and their IPs are not fixed.
ALLOW_LAN_ORIGINS=false
# Requests per device per 15 minutes for /api (live updates make every device reload lists).
API_RATE_LIMIT_MAX=5000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
