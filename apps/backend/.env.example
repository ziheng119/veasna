# Shared by "npm run dev" and "npm start". Addresses that differ between this laptop and the
# clinic network go in .env.development and .env.production, which win over this file.
# "npm run setup:env" (from the project folder) creates all three from the .example files.
DB_USER=your_postgres_user
DB_HOST=localhost
DB_NAME=veasna_screening
DB_PASSWORD=your_postgres_password
DB_PORT=5432

PORT=3000
JWT_SECRET=replace_with_long_random_secret
# Requests per device per 15 minutes for /api (live updates make every device reload lists).
API_RATE_LIMIT_MAX=5000
# Database backups (npm run backup, and every BACKUP_INTERVAL_HOURS under npm start; 0 = off).
# BACKUP_DIR=E:\veasna-backups
# BACKUP_INTERVAL_HOURS=2
# BACKUP_KEEP=30
# PG_BIN=C:\Program Files\PostgreSQL\18\bin
