DB_USER=your_postgres_user
DB_HOST=localhost
DB_NAME=veasna_screening
DB_PASSWORD=your_postgres_password
DB_PORT=5432

PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_long_random_secret

# CORS: leave unset on a LAN so the server reflects each client's origin
# (clients connect via the host IP, not localhost). Set a comma-separated
# allowlist to restrict it, e.g. http://192.168.1.50:3001,http://localhost:3001
# CORS_ALLOWED_ORIGINS=

# Offline/LAN deployment: skip the general API rate limiter (the auth limiter
# still applies). Leave unset for internet-facing deployments.
# OFFLINE_MODE=true

# Per-IP request ceilings per 15 min. Defaults shown.
# API_RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=100

# Set to false to require a token for POST /api/auth/register.
# ALLOW_OPEN_REGISTRATION=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
